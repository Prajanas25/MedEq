# Copy this file to ".env" and paste your own key in.
# Get a free key at: https://aistudio.google.com/apikey
#
# NEVER commit the real .env file, and never include it in a zip you share.
# If a key has been shared, revoke it in Google AI Studio and issue a new one.
#
# This is OPTIONAL. Without it the app still runs end to end - /dispatch
# falls back to a detailed offline SOP template instead of an LLM-written one.
GEMINI_API_KEY=your_gemini_api_key_here